{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "hosting-redirect",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "**",
        "destination": "https://luisrcsb.github.io/ctad/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
